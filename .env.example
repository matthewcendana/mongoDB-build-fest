# MongoDB Atlas connection (required)
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/
DB_NAME=never_cold

# Atlas Automated Embedding — no OpenAI / Voyage API keys.
# Atlas hosts Voyage models and embeds memory_text at index-time and query-time.
MEMORY_INDEX_NAME=memory_index
AUTOEMBED_MODEL=voyage-4-lite

# Vector Search index on never_cold.caller_profiles (app tries to create this on startup).
# Atlas UI: Search & Vector Search → Create Index → JSON Editor
# {
#   "fields": [
#     {
#       "type": "autoEmbed",
#       "modality": "text",
#       "path": "memory_text",
#       "model": "voyage-4-lite"
#     },
#     { "type": "filter", "path": "phone" }
#   ]
# }
#
# If an older memory_index exists on path "embedding", drop it first.
