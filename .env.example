# MongoDB Atlas connection (required)
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/
DB_NAME=never_cold

# Atlas Automated Embedding — no OpenAI / Voyage API keys.
# Atlas hosts Voyage models and embeds memory_text at index-time and query-time.
MEMORY_INDEX_NAME=memory_index
AUTOEMBED_MODEL=voyage-4-lite

# Vector Search index on never_cold.caller_profiles (app tries to create this on startup).
# Atlas UI: Search & Vector Search → Create Index → JSON Editor
# {
#   "fields": [
#     {
#       "type": "autoEmbed",
#       "modality": "text",
#       "path": "memory_text",
#       "model": "voyage-4-lite"
#     },
#     { "type": "filter", "path": "phone" }
#   ]
# }
#
# If an older memory_index exists on path "embedding", drop it first.

# ElevenLabs Conversational AI (Next.js patient voice guide)
# Copy these into .env.local for `next dev`. Do not commit real keys.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Public agents only (auth disabled). Used if ELEVENLABS_API_KEY is unset.
# NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# FastAPI persistence used by Next.js /api/persistence and session init
PERSISTENCE_API_URL=http://localhost:8000

# In the ElevenLabs agent, add matching client tools so the form updates live:
# get_caller_context, upsert_field(field, value), record_comprehension(clause_id, summary),
# record_consent, advance_step(step). Server tools can stay pointed at FastAPI.
