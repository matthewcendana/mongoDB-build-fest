# MongoDB Atlas connection (required)
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/
DB_NAME=never_cold

# Optional: client-side embeddings for Atlas Vector Search.
# If unset, profile lookup falls back to exact phone match (resume/adapt still work).
# Uses OpenAI-compatible embeddings endpoint (text-embedding-3-small, 1536 dims).
EMBEDDING_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
MEMORY_INDEX_NAME=memory_index

# Atlas Vector Search index on never_cold.caller_profiles (create in Atlas UI if startup cannot):
# {
#   "name": "memory_index",
#   "type": "vectorSearch",
#   "definition": {
#     "fields": [
#       { "type": "vector", "path": "embedding", "numDimensions": 1536, "similarity": "cosine" },
#       { "type": "filter", "path": "phone" }
#     ]
#   }
# }
